{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/contract_guard.py\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "ASA contract guard"
          }
        ]
      }
    ]
  }
}
