apps/backend/__pycache__/
apps/backend/*.py[cod]
apps/backend/*.pyo
apps/backend/*.egg-info/
apps/backend/build/
apps/backend/dist/
apps/backend/venv
apps/backend/venv/
apps/backend/venv.*
