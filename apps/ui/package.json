{
  "name": "sonic-analyzer-ui",
  "private": true,
  "version": "1.6.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:local": "vite --port=3100 --host=127.0.0.1 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:react": "react-doctor",
    "test": "vitest run",
    "test:unit": "vitest run tests/services",
    "test:e2e": "playwright test --config=playwright.full.config.ts --reporter=list",
    "test:e2e:integration": "playwright test tests/e2e/analysis-runs-integration.spec.ts --config=playwright.integration.config.ts --reporter=list",
    "test:e2e:headed": "playwright test --config=playwright.full.config.ts --headed --reporter=list",
    "test:smoke": "playwright test --reporter=list",
    "test:smoke:live-gemini": "playwright test tests/smoke/upload-phase2-live-gemini.spec.ts --reporter=list",
    "verify": "npm run lint && npm run test:unit && npm run build && npm run test:smoke",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "midi-writer-js": "^3.2.1",
    "motion": "^12.35.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.0",
    "wavesurfer.js": "^7.12.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "chromatic": "^16.10.1",
    "react-doctor": "^0.4.2",
    "storybook": "^10.4.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
